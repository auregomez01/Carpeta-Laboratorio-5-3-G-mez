Paleta p1, p2;
Pelota pelota;

int puntos1 = 0;
int puntos2 = 0;

void setup() {
  size(800, 500);

  p1 = new Paleta(20, height/2-50);
  p2 = new Paleta(width-35, height/2-50);

  pelota = new Pelota();
}

void draw() {
  background(0);

  stroke(255);
  line(width/2, 0, width/2, height);

  p1.mostrar();
  p2.mostrar();

  pelota.mostrar();
  pelota.mover();
  pelota.rebote(p1, p2);

  fill(255);
  textSize(32);
  text(puntos1, width/4, 40);
  text(puntos2, width*3/4, 40);

  if (keyPressed) {

    // Jugador izquierdo
    if (key=='w' || key=='W')
      p1.moverArriba();

    if (key=='s' || key=='S')
      p1.moverAbajo();

    // Jugador derecho
    if (keyCode==UP)
      p2.moverArriba();

    if (keyCode==DOWN)
      p2.moverAbajo();
  }
}

//clase paleta
class Paleta {

  float x, y;
  float ancho = 15;
  float alto = 100;
  float vel = 7;

  Paleta(float x, float y) {
    this.x = x;
    this.y = y;
  }

  void mostrar() {
    fill(255);
    rect(x, y, ancho, alto);
  }

  void moverArriba() {
    y -= vel;

    if (y < 0)
      y = 0;
  }

  void moverAbajo() {
    y += vel;

    if (y > height-alto)
      y = height-alto;
  }
}

//clase pelota
class Pelota {

  float x, y;
  float dx, dy;
  float r = 10;

  Pelota() {
    reiniciar();
  }

  void mostrar() {
    ellipse(x, y, r*2, r*2);
  }

  void mover() {

    x += dx;
    y += dy;

    // Rebote arriba y abajo
    if (y < r || y > height-r)
      dy *= -1;

    // Gol del jugador derecho
    if (x < 0) {
      puntos2++;
      reiniciar();
    }

    // Gol del jugador izquierdo
    if (x > width) {
      puntos1++;
      reiniciar();
    }
  }

  void rebote(Paleta a, Paleta b) {

    // Paleta izquierda
    if (x-r < a.x+a.ancho &&
      y > a.y &&
      y < a.y+a.alto) {

      dx *= -1;
      x = a.x+a.ancho+r;
    }

    // Paleta derecha
    if (x+r > b.x &&
      y > b.y &&
      y < b.y+b.alto) {

      dx *= -1;
      x = b.x-r;
    }
  }

  void reiniciar() {

    x = width/2;
    y = height/2;

    dx = random(1) < 0.5 ? 5 : -5;
    dy = random(-4, 4);
  }
}


